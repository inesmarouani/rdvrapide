# Copie ce fichier en ".env" à la racine du projet avant de lancer
# `docker compose up`.

POSTGRES_USER=rdvrapide
POSTGRES_PASSWORD=change_moi_en_production
POSTGRES_DB=rdvrapide

# Optionnel — active le bouton "Analyser avec Claude" du tableau de bord.
# Clé disponible sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OBLIGATOIRES — protègent l'application. Sans ça, docker compose refuse de démarrer.
# APP_PASSWORD : le mot de passe que tu utiliseras pour te connecter à l'app.
# SECRET_KEY : une chaîne longue et aléatoire (change-la, ne la partage jamais).
#   Génère-en une avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PASSWORD=
SECRET_KEY=

# À définir uniquement en hébergement public (voir README) — l'URL exacte de
# ton frontend déployé, pour que le backend accepte ses requêtes.
CORS_ORIGINS=
